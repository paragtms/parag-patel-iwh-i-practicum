doctype html
html
  head 
        title Contacts Data
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
  body
    h1 Custom Object Table
    table
     thead
      tr
        th(rowspan='2') FirstName
        th(rowspan='2') LastName
        th(rowspan='2') Email
        th(colspan='4') Pet
      tr
        th Name
        th Type
        th Age
        th Gender
     tbody
      each record in data
        if record.associatedContacts && record.associatedContacts.length
          each contact in record.associatedContacts
            tr
              td= contact.properties.firstname
              td= contact.properties.lastname
              td= contact.properties.email
              td= record.properties.name
              td= record.properties.type
              td= record.properties.age
              td= record.properties.gender
      div.spacer        
        a(href='/update-cobj') Add to this table